  "sizing": {
    "touchMin": "44px",
    "touchPreferred": "48px",
    "buttonHeight": "48px",
    "inputHeight": "48px",
    "bottomNavHeight": "64px",
    "appBarHeight": "56px",
    "adminSideNavWidth": "248px",
    "mobileContentMax": "480px",
    "adminContentMax": "1440px"
